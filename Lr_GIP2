import tkinter as tk
import random

def print_hello():
    print("hello")
colors = ['blue', 'red']
def change_color(event=None):
    colors = ['blue', 'yellow', 'pink', 'red', 'orange', 'brown', 'black', 'gray', 'violet', 'green']
    root.configure(bg=random.choice(colors))
root = tk.Tk()
root.title("hello")
root.geometry("450x470")


label = tk.Label(root, text="I'm a glad to see you", font=('Arial', 20))
label.pack()

hello_button = tk.Button(root, text="print", command=print_hello, width=15, height=2)
hello_button.pack()


exit_button = tk.Button(root, text="Exit", command=root.destroy, width=15, height=2)
exit_button.pack(side='bottom')

button_3 = tk.Button(root, text="Смена цвета", width=15, height=2)
button_3.pack()
button_3.bind("<Button-1>", change_color)

root.mainloop()
